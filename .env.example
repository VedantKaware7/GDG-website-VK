# ==========================================
# 1. LOCAL EMULATOR CONFIGURATION (Optional)
# ==========================================
# Uncomment to use local Firestore emulator instead of production Cloud Firestore:
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# ==========================================
# 2. FIREBASE FIRESTORE CONFIGURATION
# ==========================================
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional alternative to the credentials above:
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ==========================================
# 4. BETTER-AUTH & SESSION CONFIGURATION
# ==========================================
BETTER_AUTH_SECRET="a_random_32_character_secret_key"
BETTER_AUTH_URL="http://localhost:3000"  # Set to production URL when deployed

# ==========================================
# 5. GOOGLE OAUTH PROVIDER (VIT Email Auth)
# ==========================================
GOOGLE_CLIENT_ID="xxxx-xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"

# ==========================================
# 6. NODEMAILER EMAIL BROADCAST (Optional)
# ==========================================
EMAIL_USERNAME="your-email@gmail.com"
EMAIL_PASSWORD="your-gmail-app-password"
